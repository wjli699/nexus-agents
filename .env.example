# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- n8n ---
GENERIC_TIMEZONE=America/Los_Angeles
N8N_ENCRYPTION_KEY=                     # generate: openssl rand -base64 32

# Your Tailscale Funnel hostname, e.g. https://mymachine.tailxxxx.ts.net/
# Must include the trailing slash on WEBHOOK_URL.
WEBHOOK_URL=
N8N_HOST=

# --- Postgres ---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=                      # anything reasonably strong
POSTGRES_DB=nexus

# --- nexus-backend (FastAPI service, docker/docker-compose.yml) ---
# LLM endpoint for intent classification. Local Ollama by default; a reasoning
# model needs "think": false in the request body (docs/JOURNAL.md #10).
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:9b
ALPHA_VANTAGE_API_KEY=                  # https://www.alphavantage.co/support/#api-key

# --- Optional: Ollama + Tailscale sidecar (docker/optional-ollama-tailscale/) ---
# Only needed if using docker-compose.ollama-tailscale.yml
TS_AUTHKEY=                             # from https://login.tailscale.com/admin/settings/keys
OLLAMA_TS_HOSTNAME=ollama-server

# --- API keys used by workflow nodes (referenced via n8n credentials,
#     not directly injected into containers — listed here just so you
#     have one place to see what you'll need) ---
# ALPHA_VANTAGE_API_KEY=                # https://www.alphavantage.co/support/#api-key
# ANTHROPIC_API_KEY=                    # https://console.anthropic.com  (if using Claude API instead of/alongside local LLM)
# TELEGRAM_BOT_TOKEN=                   # from @BotFather — stored as an n8n credential, not env var, but noted here for reference
